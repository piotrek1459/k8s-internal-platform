{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "privateLAN": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "address",
        "httpsPort",
        "allowedCIDRs",
        "managementHostname",
        "applicationDomain",
        "tlsSecretName",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "address": {
          "type": "string"
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "allowedCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(8|9|[12][0-9]|3[0-2])$"
              },
              {
                "pattern": "^172\\.(1[6-9]|2[0-9]|3[01])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(1[2-9]|2[0-9]|3[0-2])$"
              },
              {
                "pattern": "^192\\.168\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(1[6-9]|2[0-9]|3[0-2])$"
              }
            ]
          }
        },
        "managementHostname": {
          "type": "string"
        },
        "applicationDomain": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "image": {
          "type": "string",
          "pattern": "^docker\\.io/library/traefik@sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "address": {
                "pattern": "^(10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(1[6-9]|2[0-9]|3[01])|192\\.168)\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              },
              "allowedCIDRs": {
                "minItems": 1
              },
              "managementHostname": {
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)+$"
              },
              "applicationDomain": {
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)+$"
              }
            }
          }
        }
      ]
    }
  }
}
