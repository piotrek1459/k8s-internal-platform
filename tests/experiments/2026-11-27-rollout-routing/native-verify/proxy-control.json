            "--entrypoints.health.address=127.0.0.1:9000",
            "--ping=true",
            "--ping.entrypoint=health"
          ],
          "image": "docker.io/library/traefik@sha256:a6c0194dda77bcb804824580f36fa7edc56e315b1acfe933366c8b52844a78a4",
          "imagePullPolicy": "IfNotPresent",
          "livenessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "host": "127.0.0.1",
              "path": "/ping",
              "port": 9000,
              "scheme": "HTTP"
            },
            "periodSeconds": 20,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "name": "ingress",
