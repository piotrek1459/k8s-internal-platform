              "memory": "192Mi"
            },
            "requests": {
              "cpu": "25m",
              "memory": "64Mi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/configuration",
              "name": "configuration",
              "readOnly": true
            },
            {
