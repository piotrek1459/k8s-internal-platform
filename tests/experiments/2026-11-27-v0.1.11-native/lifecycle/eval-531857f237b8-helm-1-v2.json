{
  "appId": "eval-531857f237b8-helm-1",
  "containerPort": 8080,
  "env": {},
  "image": {
    "digest": "sha256:a83f3f1d6315db2427f48d721bd144a81870160259daef40fe2dc57d91c086a6",
    "pullPolicy": "IfNotPresent",
    "repository": "platform.local/http-demo",
    "tag": ""
  },
  "imagePullSecrets": [],
  "ingress": {
    "className": "traefik",
    "enabled": false,
    "entrypoint": "private",
    "hostname": "",
    "tls": {
      "enabled": false,
      "secretName": ""
    }
  },
  "probes": {
    "liveness": {
      "enabled": false,
      "failureThreshold": 3,
      "initialDelaySeconds": 0,
      "path": "/healthz",
      "periodSeconds": 10,
      "timeoutSeconds": 1,
      "type": "http"
    },
    "readiness": {
      "enabled": true,
      "failureThreshold": 3,
      "initialDelaySeconds": 0,
      "path": "/readyz",
      "periodSeconds": 5,
      "timeoutSeconds": 1,
      "type": "http"
    },
    "startup": {
      "enabled": true,
      "failureThreshold": 30,
      "initialDelaySeconds": 0,
      "path": "/healthz",
      "periodSeconds": 2,
      "timeoutSeconds": 1,
      "type": "http"
    }
  },
  "replicas": 1,
  "resources": {
    "limits": {
      "cpu": "250m",
      "memory": "128Mi"
    },
    "requests": {
      "cpu": "25m",
      "memory": "48Mi"
    }
  },
  "restartToken": "",
  "secretRefs": []
